{
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.bomlaah.com"
        }
      ],
      "dest": "/organisateurs/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "scan.bomlaah.com"
        }
      ],
      "dest": "/scan/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/organisateurs/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/scan/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
